# Python environments & caches
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
*.egg-info/

# Data (Ignored in Git, keeping directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/tokenized/*
!data/tokenized/.gitkeep

# Results models & weights (Ignored in Git, kept on cloud/local disk)
results/models/*
!results/models/.gitkeep
*.pt
*.bin
*.safetensors

# Temporary test runs
experiments/test_run/

# LaTeX build artifacts
thesis/*.aux
thesis/*.log
thesis/*.out
thesis/*.toc
thesis/*.bbl
thesis/*.blg
thesis/*.synctex.gz
thesis/*.bcf
thesis/*.run.xml
thesis/*.fdb_latexmk
thesis/*.fls
thesis/*.lof
thesis/*.lot
thesis/kapitoly/*.aux
thesis/chapters/*.aux

# System & IDE
.idea/
.vscode/
*.DS_Store
